# Supabase の接続情報（公開してよい値）。このファイルをコピーして .env.local を作り、値を入れる。
# 未設定のままだと「お試しモード」（同じブラウザの別タブ同士でだけ対戦できる）で動く。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# フィードバックをメールで受け取る（サーバー側だけで使う秘密の値。NEXT_PUBLIC_ を付けない）。
# 未設定ならメールは送らず、Supabase の trivia_battle_feedback テーブルに保存するだけ。
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# FEEDBACK_TO_EMAIL=you@example.com
